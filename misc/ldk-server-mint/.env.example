COMPOSE_PROJECT_NAME=hedwig-mint

# Build locally by default. Replace with a pushed image tag or digest for
# production rollouts once CI publishes the image.
CDK_MINTD_IMAGE=hedwig/cdk-mintd-ldk-server:local

# Public mint URL advertised in NUT-06.
MINT_URL=https://mint.hedwig.sh/

# cdk-mintd binds only to host loopback. Host Caddy proxies to this port.
MINT_LISTEN_PORT=3338

# Prefer a private or loopback LDK Server API listener. Do not expose this API
# publicly; firewall it if it must bind outside 127.0.0.1.
LDK_SERVER_ADDRESS=127.0.0.1:3536

# Runtime uid/gid from misc/ldk-server-mint/Dockerfile.
CDK_MINTD_UID=10001
CDK_MINTD_GID=10001

# Avoid inheriting an operator shell's RUST_LOG accidentally.
CDK_MINTD_RUST_LOG=info
